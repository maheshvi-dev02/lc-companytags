{
  "manifest_version": 3,
  "name": "Company Lens for LeetCode",
  "version": "1.6.26",
  "description": "See company logos and frequency scores in a compact LeetCode bar. Search companies and problems from the toolbar.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*",
    "https://leetcode.com/*",
    "https://www.leetcode.com/*",
    "https://leetcode.cn/*",
    "https://www.leetcode.cn/*"
  ],
  "action": {
    "default_title": "Company Lens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://www.leetcode.com/*",
        "https://leetcode.cn/*",
        "https://www.leetcode.cn/*"
      ],
      "js": [
        "core.js",
        "completion.js",
        "lookup.js",
        "logo-catalog.js",
        "company-logos.js",
        "completion-content.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logos/*.svg",
        "logos/*.png"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://www.leetcode.com/*",
        "https://leetcode.cn/*",
        "https://www.leetcode.cn/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://codeload.github.com"
  },
  "minimum_chrome_version": "127",
  "background": {
    "service_worker": "background.js"
  }
}
