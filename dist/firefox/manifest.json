{
  "manifest_version": 3,
  "name": "Company Lens for LeetCode",
  "version": "1.1.0",
  "description": "See company tags on LeetCode problems, synced from the public liquidslr GitHub repository.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://leetcode.com/*",
    "https://www.leetcode.com/*",
    "https://leetcode.cn/*",
    "https://www.leetcode.cn/*"
  ],
  "action": {
    "default_title": "Company Lens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://www.leetcode.com/*",
        "https://leetcode.cn/*",
        "https://www.leetcode.cn/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.github.com https://raw.githubusercontent.com"
  },
  "background": {
    "scripts": [
      "core.js",
      "sync.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "company-lens@leetcode-tags.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
